rules_version = '2';

// Asistencia Spaces — reglas Firestore
// Modelo de seguridad:
//  1) STAFF: usuarios autenticados con Google cuyo correo esté en el allowlist
//     pueden leer/escribir. La misma lista vive en js/core/constants.js
//     (AUTHORIZED_EMAILS) — mantener ambas sincronizadas.
//  2) PORTAL (clientes): usuarios con cuenta email/contraseña autorizados vía
//     un documento en portalUsers/{correo} (creado desde Asistencia). Solo
//     LECTURA y solo de los documentos de SU clienteId. Se exige correo
//     verificado para impedir que alguien registre un correo ajeno.
//
// Roles (admin/operacion/consulta/finanzas) están preparados vía la función
// canWrite(). Hoy todos los autorizados pueden operar; para endurecer, restringe
// write a roles concretos usando custom claims (request.auth.token.role).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function emailAllowed() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'alekcaballeromusic@gmail.com',
          'catalina.medina.leal@gmail.com',
          'imusicala@gmail.com',
          'musicalaasesor@gmail.com'
        ];
    }

    function canRead() { return emailAllowed(); }
    function canWrite() { return emailAllowed(); }
    function isAdmin() {
      return emailAllowed()
        && request.auth.token.email in [
          'alekcaballeromusic@gmail.com',
          'imusicala@gmail.com'
        ];
    }

    // ── Portal de clientes ──────────────────────────────────────
    // portalUsers/{correo-en-minusculas} → { clienteId, activo, ... }
    function portalDoc() {
      return get(/databases/$(database)/documents/portalUsers/$(request.auth.token.email)).data;
    }

    function isPortalUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/portalUsers/$(request.auth.token.email))
        && portalDoc().activo == true;
    }

    // ¿El usuario del portal es dueño de este clienteId?
    function portalOwns(clienteId) {
      return isPortalUser() && portalDoc().clienteId == clienteId;
    }

    match /portalUsers/{email} {
      // El cliente puede leer SU propio doc de acceso (para saber su clienteId).
      // No exigimos email_verified aquí: el portal necesita leerlo para
      // decidir qué pantalla mostrar (incluida la de "verifica tu correo").
      allow get: if canRead()
        || (isSignedIn() && request.auth.token.email == email);
      allow list: if canRead();
      allow write: if canWrite();
    }

    match /clientes/{id} {
      allow get: if canRead() || portalOwns(id);
      allow list: if canRead();
      allow write: if canWrite();
    }

    match /paquetes/{id} {
      allow read: if canRead() || portalOwns(resource.data.clienteId);
      allow write: if canWrite();
    }

    match /asistentes/{id} {
      allow read: if canRead() || portalOwns(resource.data.clienteId);
      allow write: if canWrite();
    }

    match /pagos/{id} {
      allow read: if canRead() || portalOwns(resource.data.clienteId);
      allow write: if canWrite();
    }

    match /reservas/{id} {
      allow read: if canRead() || portalOwns(resource.data.clienteId);
      allow write: if canWrite();

      match /asistencia/{asistenteId} {
        // El portal puede leer la asistencia si la reserva padre es suya.
        allow read: if canRead()
          || portalOwns(get(/databases/$(database)/documents/reservas/$(id)).data.clienteId);
        allow write: if canWrite();
      }
    }

    // Auditoría: cualquier autorizado lee y crea; nadie edita/borra.
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if emailAllowed();
      allow update, delete: if false;
    }

    match /usuarios/{id} {
      allow read: if canRead();
      allow write: if canWrite();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
